# Copy this file to .env before the first start.
# These credentials are for local coursework demonstration only.
LIBRARY_DB_USER=library_admin
LIBRARY_DB_PASSWORD=library_password
LIBRARY_DB_HOST=127.0.0.1
LIBRARY_DB_BIND_HOST=127.0.0.1

# Host ports can be changed when another PostgreSQL instance occupies a port.
COORDINATOR_DB_PORT=5436
SITE1_DB_PORT=5433
SITE2_DB_PORT=5434
SITE3_DB_PORT=5435

# Local FastAPI services.
SITE1_API_URL=http://127.0.0.1:8001
SITE2_API_URL=http://127.0.0.1:8002
SITE3_API_URL=http://127.0.0.1:8003

# Replace these values before any non-local deployment.
INTERNAL_API_TOKEN=distributed-library-development-token
AUTH_SECRET=local-coursework-secret-change-before-deployment
ACCESS_TOKEN_MINUTES=480
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=500
